{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun"],
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "jsxImportSource": "jsx-runtime",
    "paths": {
      "depot-client": ["./src/lib/steamapi/depot-client/index.ts"],
      "depot-client/*": ["./src/lib/steamapi/depot-client/*"],
      "#config": ["./src/config/index.ts"],
      "#config/*": ["./src/config/*"],
      "#lib": ["./src/lib/index.ts"],
      "#lib/*": ["./src/lib/*"],
      "jsx-runtime": ["./jsx-runtime.ts"],
      "jsx-runtime/*": ["./jsx-runtime.ts"]
    }
  },
  "include": ["**/*"],
  "exclude": ["src/api"]
}
