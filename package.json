{
  "name": "ServerZ",
  "description": "DayZ server for containerized environments",
  "author": "GodBleak",
  "license": "MIT",
  "version": "2.0.0",
  "keywords": [
    "DayZ",
    "Server"
  ],
  "main": "src/index.ts",
  "type": "module",
  "workspaces": [
    "./src/lib/steamapi/depot-client/"
  ],
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "gen:config-docs": "bun scripts/generate-config-docs.ts --write",
    "check:config-docs": "bun scripts/generate-config-docs.ts --check",
    "test": "bun test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:suggestions": "oxlint --fix-suggestions .",
    "license:summary": "license-checker-rseidelsohn --production --excludePrivatePackages --summary",
    "check:licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --failOn \"GPL;GPL-1.0;GPL-2.0;GPL-3.0;GPL-2.0-only;GPL-2.0-or-later;GPL-3.0-only;GPL-3.0-or-later;AGPL;AGPL-1.0;AGPL-3.0;AGPL-3.0-only;AGPL-3.0-or-later;SSPL;SSPL-1.0\"",
    "typecheck": "tsc --noEmit",
    "update:depot-daemon-subtrees": "bun scripts/update-depot-daemon-subtrees.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "bun-pty": "^0.4.9",
    "cli-progress": "^3.12.0",
    "config": "^4.4.1",
    "qrcode-terminal": "^0.12.0",
    "simple-git": "^3.36.0",
    "strip-ansi": "^7.2.0",
    "unzipit": "^2.0.3",
    "@feathersjs/feathers": "^5.0.45",
    "@feathersjs/socketio-client": "^5.0.45",
    "engine.io-client": "^6.6.6",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/cli-progress": "^3.11.6",
    "@types/config": "^4.4.0",
    "@types/node": "^25.9.3",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/steam-user": "^5.1.1",
    "comment-parser": "^1.4.7",
    "license-checker-rseidelsohn": "5.0.1",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "prettier": "^3.8.4",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3"
  }
}
