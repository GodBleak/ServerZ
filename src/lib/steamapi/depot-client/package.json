{
  "name": "depot-client",
  "version": "0.1.0",
  "description": "Reusable TypeScript API for Steam app/depot manifest resolution and SteamPipe downloads, with QR login support.",
  "type": "module",
  "license": "MIT",
  "author": "GodBleak <meow@godbleak.com>",
  "keywords": [
    "steam",
    "steampipe",
    "depot",
    "manifest",
    "download",
    "workshop",
    "steam-user",
    "steam-session",
    "bun"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "native",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev:qr": "bun run examples/qr-login.ts",
    "dev:download": "bun run examples/download-app.ts",
    "prepublishOnly": "bun run typecheck && bun run build",
    "build:native:lzma": "bun run ./scripts/build-native-lzma.ts",
    "build:all": "bun run build:native:lzma && bun run build",
    "dev:workshop": "bun run examples/download-workshop.ts",
    "dev:validate": "bun run examples/validate-app.ts"
  },
  "dependencies": {
    "@doctormckay/steam-crypto": "^1.2.0",
    "steam-session": "^1.9.4",
    "steam-user": "^5.3.0",
    "adm-zip": "^0.5.17",
    "lzma": "^2.3.2",
    "zstddec": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "bun-types": "^1.3.14",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "@mongodb-js/zstd": {
      "optional": true
    },
    "@zig-wasm/compress": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@mongodb-js/zstd": "^7.0.0",
    "@zig-wasm/compress": "^0.1.0"
  }
}
